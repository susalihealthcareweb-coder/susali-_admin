// SUSALI data model. Follows section 8 of the functional specification.
// Additions beyond the spec are marked "Added".

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  SUDO_ADMIN
  SUPPORT
  CLUSTER_MANAGER
  HOSPITAL_USER
}

enum ReferralStatus {
  DRAFT
  SUBMITTED
  UNDER_VERIFICATION
  INFO_REQUESTED
  REJECTED
  FORWARDED
  HOSPITAL_DECLINED
  ACCEPTED
  VISITED
  UNDER_TREATMENT
  COMPLETED
  CLOSED
  CANCELLED
}

enum Urgency {
  ROUTINE
  URGENT
  EMERGENCY
}

enum DocCategory {
  REFERRAL_LETTER
  PREVIOUS_REPORT
  PRESCRIPTION
  LAB_REPORT
  SCAN
  DISCHARGE_SUMMARY
  OTHER
}

enum Channel {
  WHATSAPP
  EMAIL
  IN_APP
  SMS
}

enum SendStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
}

model User {
  id                  String                  @id @default(auto()) @map("_id") @db.ObjectId
  name                String
  email               String                  @unique
  mobile              String                  @unique
  passwordHash        String
  role                Role
  isActive            Boolean                 @default(true)
  clusterIds          String[]                @db.ObjectId
  clusters            Cluster[]               @relation(fields: [clusterIds], references: [id])
  hospitalId          String?                 @db.ObjectId
  hospital            Hospital?               @relation(fields: [hospitalId], references: [id])
  muteWhatsapp        Boolean                 @default(false)
  muteEmail           Boolean                 @default(false)
  lastLoginAt         DateTime?
  deletionRequestedAt DateTime? // Added: account deletion requested from the app
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  companiesCreated    Company[]               @relation("CompanyCreatedBy")
  visits              CompanyVisit[]
  verifiedReferrals   Referral[]              @relation("VerifiedBy")
  lockedReferrals     Referral[]              @relation("LockedBy")
  raisedReferrals     Referral[]              @relation("RaisedBy")
  statusChanges       ReferralStatusHistory[]
  documents           Document[]
  notifications       Notification[]
}

model Cluster {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  name       String    @unique
  code       String    @unique
  region     String?
  managerIds String[]  @db.ObjectId
  managers   User[]    @relation(fields: [managerIds], references: [id])
  companies  Company[]
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
}

model Company {
  id           String         @id @default(auto()) @map("_id") @db.ObjectId
  code         String         @unique
  name         String
  industry     String?
  address      String
  city         String
  district     String?
  state        String
  pincode      String
  gstNumber    String?
  hrName       String?
  hrMobile     String?
  hrEmail      String?
  clusterId    String         @db.ObjectId
  cluster      Cluster        @relation(fields: [clusterId], references: [id])
  dispensaryId String?        @db.ObjectId
  dispensary   Dispensary?    @relation(fields: [dispensaryId], references: [id])
  createdById  String         @db.ObjectId
  createdBy    User           @relation("CompanyCreatedBy", fields: [createdById], references: [id])
  isActive     Boolean        @default(true)
  employees    Employee[]
  visits       CompanyVisit[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([clusterId])
}

model CompanyVisit {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  companyId String   @db.ObjectId
  company   Company  @relation(fields: [companyId], references: [id])
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  visitedAt DateTime
  latitude  Float?
  longitude Float?
  photoKey  String?
  remarks   String?
  createdAt DateTime @default(now())
}

model Employee {
  id                  String         @id @default(auto()) @map("_id") @db.ObjectId
  employeeCode        String
  companyId           String         @db.ObjectId
  company             Company        @relation(fields: [companyId], references: [id])
  fullName            String
  gender              String
  dateOfBirth         DateTime
  mobile              String         @unique
  email               String?
  aadhaarLast4        String?
  department          String?
  designation         String?
  bloodGroup          String?
  address             String?
  emergencyName       String?
  emergencyMobile     String?
  isActive            Boolean        @default(true)
  lastLoginAt         DateTime?
  consentAt           DateTime? // Added: DPDP consent given at first login
  // Added: self-registration. Null means added by a Cluster Manager (approved).
  approvalStatus      String? // PENDING | APPROVED | REJECTED
  selfRegistered      Boolean        @default(false)
  approvalNote        String?
  approvedById        String?        @db.ObjectId
  approvedAt          DateTime?
  deletionRequestedAt DateTime? // Added: account deletion requested from the app
  referrals           Referral[]
  notifications       Notification[]
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  familyMembers       FamilyMember[]

  @@unique([companyId, employeeCode])
  @@index([approvalStatus])
}

// Added: family members covered by the employee's card. A referral can be
// raised for the employee ("Self") or for one of them.
model FamilyMember {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  employeeId  String     @db.ObjectId
  employee    Employee   @relation(fields: [employeeId], references: [id])
  fullName    String
  relation    String
  gender      String
  dateOfBirth DateTime
  bloodGroup  String?
  mobile      String?
  isActive    Boolean    @default(true)
  referrals   Referral[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([employeeId])
}

model Dispensary {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  address   String?
  city      String?
  isActive  Boolean    @default(true)
  companies Company[]
  referrals Referral[]
}

model SuperintendentHospital {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  address   String?
  city      String?
  isActive  Boolean    @default(true)
  referrals Referral[]
}

model Hospital {
  id            String     @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  code          String     @unique
  address       String
  city          String
  state         String
  pincode       String
  phone         String
  email         String
  departmentIds String[]   @db.ObjectId
  isActive      Boolean    @default(true)
  users         User[]
  referrals     Referral[]
  createdAt     DateTime   @default(now())
}

model Department {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  name      String     @unique
  referrals Referral[]
}

// Fields that a patient fills in are optional here so a Draft can be saved
// part-way; the submit route enforces that they are all present.
model Referral {
  id                       String                  @id @default(auto()) @map("_id") @db.ObjectId
  referralNo               String                  @unique
  employeeId               String                  @db.ObjectId
  employee                 Employee                @relation(fields: [employeeId], references: [id])
  familyMemberId           String?                 @db.ObjectId // Added: null = the employee themself
  familyMember             FamilyMember?           @relation(fields: [familyMemberId], references: [id])
  patientName              String? // Added: who is being treated
  patientRelation          String? // Added: "Self" or relation to the employee
  raisedById               String?                 @db.ObjectId // Added: staff member who raised it for the employee
  raisedBy                 User?                   @relation("RaisedBy", fields: [raisedById], references: [id])
  companyId                String                  @db.ObjectId
  clusterId                String                  @db.ObjectId
  patientSnapshot          Json?
  dispensaryId             String?                 @db.ObjectId
  dispensary               Dispensary?             @relation(fields: [dispensaryId], references: [id])
  dispensaryVisitDate      DateTime?
  superintendentHospitalId String?                 @db.ObjectId
  superintendentHospital   SuperintendentHospital? @relation(fields: [superintendentHospitalId], references: [id])
  superintendentName       String?
  referralLetterNo         String?
  referralDate             DateTime?
  hospitalId               String?                 @db.ObjectId
  hospital                 Hospital?               @relation(fields: [hospitalId], references: [id])
  departmentId             String?                 @db.ObjectId
  department               Department?             @relation(fields: [departmentId], references: [id])
  diagnosis                String?
  urgency                  Urgency                 @default(ROUTINE)
  status                   ReferralStatus          @default(DRAFT)
  lockedById               String?                 @db.ObjectId
  lockedBy                 User?                   @relation("LockedBy", fields: [lockedById], references: [id])
  verifiedById             String?                 @db.ObjectId
  verifiedBy               User?                   @relation("VerifiedBy", fields: [verifiedById], references: [id])
  verifierNotes            String?
  infoRequestNote          String?
  rejectReason             String?
  declineReason            String?
  visitType                String?
  treatingDoctor           String?
  admissionDate            DateTime?
  treatmentNotes           String? // Added: notes recorded during care
  escalations              String[] // Added: escalation stages already raised, so each fires once
  submittedAt              DateTime?
  forwardedAt              DateTime?
  acceptedAt               DateTime?
  visitedAt                DateTime?
  completedAt              DateTime?
  closedAt                 DateTime?
  history                  ReferralStatusHistory[]
  documents                Document[]
  notifications            Notification[]
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt

  @@index([status])
  @@index([clusterId, status])
  @@index([hospitalId, status])
  @@index([employeeId])
  @@index([companyId])
}

model ReferralStatusHistory {
  id             String          @id @default(auto()) @map("_id") @db.ObjectId
  referralId     String          @db.ObjectId
  referral       Referral        @relation(fields: [referralId], references: [id])
  fromStatus     ReferralStatus?
  toStatus       ReferralStatus
  actorUserId    String?         @db.ObjectId
  actorUser      User?           @relation(fields: [actorUserId], references: [id])
  actorIsPatient Boolean         @default(false)
  remarks        String?
  createdAt      DateTime        @default(now())

  @@index([referralId])
}

model Document {
  id                String      @id @default(auto()) @map("_id") @db.ObjectId
  referralId        String      @db.ObjectId
  referral          Referral    @relation(fields: [referralId], references: [id])
  category          DocCategory
  fileName          String
  storageKey        String
  mimeType          String
  sizeBytes         Int
  uploadedById      String?     @db.ObjectId
  uploadedBy        User?       @relation(fields: [uploadedById], references: [id])
  uploadedByPatient Boolean     @default(false)
  isDeleted         Boolean     @default(false)
  createdAt         DateTime    @default(now())

  @@index([referralId, category])
}

model Notification {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  event        String
  channel      Channel
  userId       String?    @db.ObjectId
  user         User?      @relation(fields: [userId], references: [id])
  employeeId   String?    @db.ObjectId
  employee     Employee?  @relation(fields: [employeeId], references: [id])
  referralId   String?    @db.ObjectId
  referral     Referral?  @relation(fields: [referralId], references: [id])
  recipient    String
  title        String
  body         String
  templateName String?
  payload      Json?
  status       SendStatus @default(QUEUED)
  attempts     Int        @default(0)
  providerRef  String?
  error        String?
  isRead       Boolean    @default(false)
  nextTryAt    DateTime   @default(now())
  createdAt    DateTime   @default(now())

  @@index([status, nextTryAt])
  @@index([userId, isRead])
  @@index([employeeId, isRead])
}

model OtpRequest {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  mobile    String
  purpose   String   @default("LOGIN") // Added: LOGIN or VISIT
  attempts  Int      @default(0)
  verified  Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([mobile])
}

model AuditLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  actorId   String?
  actorRole String
  action    String
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId])
  @@index([createdAt])
}

// Added: atomic counters for SUS-REF-2026-000123 and SUS-CMP-0001 numbers.
model Counter {
  id  String @id @map("_id")
  seq Int    @default(0)
}

// Added: system settings and notification templates edited by Super Admin.
model Setting {
  id        String   @id @map("_id")
  value     Json
  updatedAt DateTime @updatedAt
}
